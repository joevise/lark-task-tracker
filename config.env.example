# lark-task-tracker 配置模板
# 复制成 config.env 后，改成你自己的表和身份即可使用
#   cp config.env.example config.env

# ===== 飞书身份 =====
# 飞书官方 lark-cli 的 profile 名（切到你自己的身份）
# 先用 lark-cli profile use <name> / lark-cli auth status 确认已授权
LARK_PROFILE="your_profile"

# ===== 任务清单多维表格 =====
# 建表方法见 SKILL.md「建表」章节；用 lark-cli base +url-resolve 拿 token
BASE_TOKEN="bascnXXXXXXXXXXXXXXXXXXXXXX"
TABLE_ID="tblXXXXXXXXXXXXXX"
BASE_URL="https://your-domain.feishu.cn/base/bascnXXXXXXXXXXXXXXXXXXXXXX"

# ===== 本人身份 =====
# 你的 open_id（推送任务清单私信 + 识别"我承诺的"消息）
# 获取：lark-cli auth status --json | jq -r '.identities.user.openId'
MY_OPEN_ID="ou_XXXXXXXXXXXXXXXXXXXXXXXXXXXXXXXX"
MY_NAME="你的名字"

# ===== 扫描窗口 =====
# 每次扫近 N 天「@我的」+「我承诺的」消息
SCAN_DAYS="7"

# 状态目录（记录已处理消息 id，避免重复入表）
STATE_DIR="$HOME/.agents/skills/lark-task-tracker/state"

# ===== AI 二次筛选（MiniMax M3）=====
# 开关：true 启用 AI 筛选（只留真任务），false 则全量入表
AI_FILTER="true"
# 你的 MiniMax API Key（https://platform.minimaxi.com 申请）
MINIMAX_API_KEY="sk-xxxxxxxxxxxxxxxxxxxxxxxxxxxxxxxx"
# 国内版 api.minimax.chat；海外版 api.minimaxi.chat
MINIMAX_API_HOST="api.minimax.chat"
MINIMAX_MODEL="MiniMax-M3"
# 每批喂给模型的候选条数（太大易超 token 被截断）
AI_FILTER_CHUNK="15"

# ===== 自动归档项目 =====
# 开关：true 让 AI 顺手判断每条任务属于哪个项目，自动写「所属项目」字段
AUTO_PROJECT="true"
# 项目字段名（任务表里的单选字段）
PROJECT_FIELD="所属项目"
# 项目总表 table_id（每项目一行，可填描述/进度；见 SKILL.md）
PROJECT_TABLE_ID="tblXXXXXXXXXXXXXX"
# 允许的项目白名单（分号隔开）—— AI 只能从这里选，不在名单里的一律置空
# ⚠️ 重要：必须用白名单，不能读字段选项。因为飞书 select 字段写入未知值会「自动新建选项」，
#          若拿字段选项做校验，模型自创的项目会被 Feishu 落地，造成项目增生。
# 你新增项目时：把名字加到这里（同时建议在项目总表也加一行）
PROJECT_WHITELIST="项目A;项目B;项目C"
